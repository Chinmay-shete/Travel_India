# Environment variables for travel_india-new
# Copy this file to .env and fill in your real values
# NEVER commit .env — it is in .gitignore

# ─── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=major_project
DB_USER=travel_user
DB_PASS=change_me_to_a_strong_password

# ─── Session ───────────────────────────────────────────────
# Must be at least 32 random characters
SESSION_SECRET=change_me_to_32_random_characters_here

# ─── PHPMailer / SMTP ──────────────────────────────────────
# Recommended: use Brevo (free 300/day) or SendGrid
# NOT Gmail App Passwords in production
MAIL_HOST=smtp.brevo.com
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USERNAME=your_brevo_smtp_username
MAIL_PASSWORD=your_brevo_smtp_key
MAIL_FROM_EMAIL=noreply@yourdomain.com
MAIL_FROM_NAME=The Real Travel

# ─── App ───────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# ─── Upload storage ────────────────────────────────────────
# Absolute path to the uploads directory (ideally OUTSIDE webroot)
UPLOAD_PATH=/var/www/travel_india_uploads

# ─── MANUAL ACTION REQUIRED ────────────────────────────────
# The Gmail App Password 'olfq duvu rucq tvsv' was exposed in source code.
# If this repo was ever pushed to GitHub or any remote:
#   1. Revoke it at: https://myaccount.google.com/apppasswords
#   2. Rotate any other credentials that shared the same account
#   3. Check git log --all -S 'olfq duvu rucq tvsv' to find all commits containing it
