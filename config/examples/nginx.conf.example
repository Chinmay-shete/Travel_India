# ─── NGINX SECURITY CONFIGURATION SNIPPETS ───

# HTTP Security Headers
add_header X-Frame-Options "SAMEORIGIN" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
add_header Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://code.jquery.com https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; font-src 'self' data: https:; frame-src 'self';" always;

# Prevent PHP script execution in the secure uploads directory
location ~* ^/uploads/.*\.php$ {
    deny all;
}

# Redirect all HTTP traffic to HTTPS (highly recommended)
# server {
#     listen 80;
#     server_name yourdomain.com;
#     return 301 https://$host$request_uri;
# }
